{
  "name": "hostel_maintainance_api",
  "version": "1.0.0",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:run": "npm run clean && npm run build && npm start",
    "clean": "rm -rf dist",
    "dev": "nodemon --exec tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "Hostel",
    "Maintainance",
    "API"
  ],
  "author": "Zion Musa",
  "license": "ISC",
  "description": "A hostel maintainance API for students to report issues",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  }
}
