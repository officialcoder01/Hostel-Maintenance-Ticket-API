{
  "name": "hostel_maintainance_api",
  "version": "1.0.0",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:run": "npm run clean && npm run build && npm start",
    "clean": "rm -rf dist",
    "dev": "nodemon --exec tsx src/server.ts",
    "dev:create-hostel": "tsx src/scripts/create-dev-hostel.ts",
    "dev:create-resident": "tsx src/scripts/create-dev-resident.ts",
    "dev:token": "tsx src/scripts/generate-dev-resident-token.ts",
    "assignments:expire": "tsx src/scripts/expire-assignments.ts",
    "start": "node dist/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc --project tsconfig.test.json"
  },
  "keywords": [
    "Hostel",
    "Maintainance",
    "API"
  ],
  "author": "Zion Musa",
  "license": "ISC",
  "description": "A hostel maintainance API for students to report issues",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
